# ---------------------------------------------------------------------------
# Kuvox AI service — environment configuration
# Copy to `.env` for local development. All variables are namespaced KUVOX_.
# ---------------------------------------------------------------------------

# --- Service ---------------------------------------------------------------
# Host/port the FastAPI server binds to.
KUVOX_HOST=0.0.0.0
KUVOX_PORT=8000
# One of: development, staging, production. Drives debug behavior & CORS.
KUVOX_ENVIRONMENT=development
# Log level: DEBUG, INFO, WARNING, ERROR.
KUVOX_LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins; "*" for dev only.
KUVOX_CORS_ORIGINS=*

# --- Kuzu (embedded graph DB) ----------------------------------------------
# Filesystem path to the Kuzu database directory. Created if missing.
KUVOX_KUZU_DB_PATH=./data/kuzu

# --- Qdrant (vector DB) ----------------------------------------------------
KUVOX_QDRANT_HOST=localhost
KUVOX_QDRANT_PORT=6333
# Optional API key for hosted Qdrant; blank for local.
KUVOX_QDRANT_API_KEY=

# --- Redis (cache / session state) -----------------------------------------
KUVOX_REDIS_URL=redis://localhost:6379/0

# --- RabbitMQ (message broker) ---------------------------------------------
KUVOX_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
KUVOX_RABBITMQ_EXCHANGE=kuvox.events
# Queue names consumed by background workers.
KUVOX_QUEUE_RENDERING=kuvox.rendering
KUVOX_QUEUE_SANDBOX=kuvox.sandbox
KUVOX_MEDIA_OPTIMIZATION_REQUESTED_QUEUE=media.optimization.requested
KUVOX_MEDIA_OPTIMIZATION_REQUESTED_ROUTING_KEY=media.optimization.requested
KUVOX_MEDIA_OPTIMIZATION_COMPLETED_ROUTING_KEY=media.optimization.completed
KUVOX_MEDIA_OPTIMIZATION_FAILED_ROUTING_KEY=media.optimization.failed
KUVOX_MEDIA_OPTIMIZATION_CONCURRENCY=1
KUVOX_INGESTION_REQUESTED_QUEUE=ingestion.requested
KUVOX_INGESTION_REQUESTED_ROUTING_KEY=ingestion.requested
KUVOX_INGESTION_COMPLETED_ROUTING_KEY=ingestion.completed
KUVOX_INGESTION_FAILED_ROUTING_KEY=ingestion.failed
KUVOX_INGESTION_CONCURRENCY=1

# --- Object storage (S3-compatible; SeaweedFS for local dev) -------------------
KUVOX_S3_ENDPOINT_URL=http://localhost:8333
KUVOX_S3_REGION=us-east-1
KUVOX_S3_ACCESS_KEY=admin
KUVOX_S3_SECRET_KEY=secret
KUVOX_S3_BUCKET=kuvox-media
KUVOX_S3_RAW_BUCKET=kuvox-raw
KUVOX_S3_CANONICAL_BUCKET=kuvox-canonical
KUVOX_S3_PROXY_BUCKET=kuvox-proxy
KUVOX_S3_THUMBNAIL_BUCKET=kuvox-thumbnails
KUVOX_S3_TEMP_BUCKET=kuvox-temp
# If true, the client will create the bucket on startup if it is missing.
KUVOX_S3_CREATE_BUCKET=true

# --- Media optimization ----------------------------------------------------
KUVOX_MEDIA_WORK_DIR=/tmp/kuvox-media
KUVOX_MEDIA_DELETE_RAW_AFTER_OPTIMIZATION=false
KUVOX_VIDEO_CANONICAL_CRF=28
KUVOX_VIDEO_PROXY_CRF=30
KUVOX_VIDEO_PROXY_MAX_WIDTH=1280
KUVOX_IMAGE_MAX_WIDTH=1920
KUVOX_THUMBNAIL_WIDTH=320

# --- Ingestion ------------------------------------------------------------
KUVOX_INGESTION_WORK_DIR=/tmp/kuvox-ingestion

# --- LLM provider ----------------------------------------------------------
# One of: stub, <future-provider-name>. Only "stub" is implemented today.
KUVOX_LLM_TIER_1_PROVIDER=groq # Main planner
KUVOX_LLM_TIER_2_PROVIDER=groq # Everything else
KUVOX_LLM_TIER_3_PROVIDER=gpt  # Escape hatch

# Groq model
GROQ_LLM_API_KEY=
GROQ_LLM_TIER_1_MODEL=
GROQ_LLM_TIER_2_MODEL=
GROQ_LLM_TIER_3_MODEL=
# OpenAI model
OPENAI_LLM_API_KEY=
OPENAI_LLM_TIER_1_MODEL=
OPENAI_LLM_TIER_2_MODEL=
OPENAI_LLM_TIER_3_MODEL=
# Claude
CLAUDE_LLM_API_KEY=
CLAUDE_LLM_TIER_1_MODEL=
CLAUDE_LLM_TIER_2_MODEL=
CLAUDE_LLM_TIER_3_MODEL=

# --- Model paths (for future ML loading) -----------------------------------
# Reserved for ingestion-tier model artifacts. Not loaded by the scaffold.
KUVOX_MODEL_DIR=./data/models
