# ---------------------------------------------------------------------------
# Kuvox AI service — environment configuration
# Copy to `.env` for local development. All variables are namespaced KUVOX_.
#
# Hostname and path rules by runtime:
# - Native Linux: use localhost for Docker-published infra ports and Unix
#   scratch paths such as /tmp/kuvox-media.
# - Native macOS: use the same localhost and /tmp/... values as Linux.
# - Native Windows: use localhost for infra, but use Windows-writable scratch
#   paths such as D:/Kuvox/.codex-tmp/kuvox-media. Avoid /tmp/... on Windows.
# - AI service running in Docker Compose: use Compose service names and Linux
#   container paths:
#   KUVOX_QDRANT_HOST=qdrant
#   KUVOX_REDIS_URL=redis://redis:6379/0
#   KUVOX_RABBITMQ_URL=amqp://kuvox:kuvox@rabbitmq:5672/
#   KUVOX_S3_ENDPOINT_URL=http://seaweedfs-s3:8333
#   KUVOX_MEDIA_WORK_DIR=/tmp/kuvox-media
#   KUVOX_RENDERING_WORK_DIR=/tmp/kuvox-rendering
#   KUVOX_INGESTION_WORK_DIR=/tmp/kuvox-ingestion
# - Do not mix per-repo Compose files with the workspace-root Compose file;
#   run exactly one infra set at a time.
# ---------------------------------------------------------------------------

# --- Service ---------------------------------------------------------------
# Host/port the FastAPI server binds to.
KUVOX_HOST=0.0.0.0
KUVOX_PORT=8000
# One of: development, staging, production. Drives debug behavior & CORS.
KUVOX_ENVIRONMENT=development
# Log level: DEBUG, INFO, WARNING, ERROR.
KUVOX_LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins; "*" for dev only.
KUVOX_CORS_ORIGINS=*
# Start RabbitMQ workers inside the FastAPI app lifecycle.
KUVOX_RUN_WORKERS=true

# --- Kuzu (embedded graph DB) ----------------------------------------------
# Filesystem path to the Kuzu database directory. Created if missing.
# Native Linux: relative or Unix paths are fine.
# Native macOS: same as Linux.
# Native Windows: use relative paths or drive paths such as D:/Kuvox/.codex-tmp/kuzu.
# Docker: use relative or Linux container paths.
KUVOX_KUZU_DB_PATH=./data/kuzu

# --- Qdrant (vector DB) ----------------------------------------------------
# Native Linux: localhost.
# Native macOS: localhost.
# Native Windows: localhost.
# Docker Compose AI container: qdrant.
KUVOX_QDRANT_HOST=localhost
KUVOX_QDRANT_PORT=6333
KUVOX_QDRANT_HTTPS=false
# Optional API key for hosted Qdrant; blank for local.
KUVOX_QDRANT_API_KEY=

# --- Redis (cache / session state) -----------------------------------------
# Native workspace Compose (API + AI): redis://localhost:6380/0.
# The AI-only standalone Compose publishes its Redis on localhost:6379.
# Production Compose AI container: redis://redis-ai:6379/0.
KUVOX_REDIS_URL=redis://localhost:6380/0
# Production uses separate ACL credentials; leave blank for auth-free local Redis.
KUVOX_REDIS_USERNAME=
KUVOX_REDIS_PASSWORD=
KUVOX_REDIS_CONNECT_TIMEOUT_SECONDS=0.5
KUVOX_REDIS_OPERATION_TIMEOUT_SECONDS=0.5
KUVOX_METRICS_ENABLED=true
KUVOX_CACHE_ENABLED=false
KUVOX_CACHE_KEY_PREFIX=kuvox:v1
KUVOX_CACHE_TTL_JITTER_PERCENT=10
KUVOX_CACHE_MAX_PAYLOAD_BYTES=1048576
KUVOX_TEXT_EMBEDDING_CACHE_TTL_SECONDS=604800
KUVOX_TEXT_EMBEDDING_CACHE_BUDGET_BYTES=100663296
KUVOX_TEXT_EMBEDDING_CACHE_LEGACY_READ_ENABLED=true
KUVOX_QUERY_EMBEDDING_CACHE_ENABLED=false
KUVOX_QUERY_EMBEDDING_SINGLE_FLIGHT_ENABLED=false
KUVOX_INGESTION_TEXT_EMBEDDING_CACHE_ENABLED=false
KUVOX_VISUAL_EMBEDDING_CACHE_ENABLED=false
KUVOX_AUDIO_EMBEDDING_CACHE_ENABLED=false
KUVOX_VISUAL_EMBEDDING_CACHE_TTL_SECONDS=86400
KUVOX_AUDIO_EMBEDDING_CACHE_TTL_SECONDS=86400
KUVOX_VISUAL_EMBEDDING_CACHE_BUDGET_BYTES=33554432
KUVOX_AUDIO_EMBEDDING_CACHE_BUDGET_BYTES=67108864
KUVOX_RETRIEVAL_CACHE_ENABLED=false
KUVOX_RETRIEVAL_CACHE_TTL_SECONDS=60
KUVOX_RETRIEVAL_CACHE_BUDGET_BYTES=67108864
KUVOX_RETRIEVAL_SINGLE_FLIGHT_ENABLED=false
KUVOX_SINGLE_FLIGHT_LOCK_TTL_SECONDS=30
KUVOX_SINGLE_FLIGHT_WAIT_SECONDS=15
KUVOX_SINGLE_FLIGHT_POLL_MILLISECONDS=50

# Production Compose Redis ACL secrets (not used by auth-free local Redis).
REDIS_API_PASSWORD=
REDIS_AI_PASSWORD=

# Frontend process-local coordination (used by the shared production Compose env file).
KUVOX_BFF_COALESCING_ENABLED=false
KUVOX_BFF_COALESCING_RESOURCES=auth_me,studio_memberships,retrieval_project_media
KUVOX_BFF_COALESCING_MAX_IN_FLIGHT=256
KUVOX_BFF_COALESCING_DEADLINE_MS=5000
KUVOX_BFF_METRICS_ENABLED=false

# ASP.NET business-read cache rollout flags (all off by default).
API_CACHING_ENABLED=false
API_HTTP_VALIDATORS_ENABLED=false
API_BUSINESS_READ_CACHING_ENABLED=false
API_USER_SETTINGS_CACHING_ENABLED=false
API_STUDIO_CACHING_ENABLED=false
API_PROJECTS_CACHING_ENABLED=false
API_MEDIA_CACHING_ENABLED=false
API_ALBUMS_CACHING_ENABLED=false
API_STORAGE_USAGE_CACHING_ENABLED=false
API_TASKS_CACHING_ENABLED=false
API_NOTIFICATION_PAGES_CACHING_ENABLED=false
API_NOTIFICATION_COUNT_CACHING_ENABLED=false
API_EDITOR_DOCUMENTS_CACHING_ENABLED=false
API_RENDER_JOBS_CACHING_ENABLED=false
API_STAMPEDE_PROTECTION_ENABLED=false
API_STUDIO_USAGE_SINGLE_FLIGHT_ENABLED=false
API_LOCK_TTL_MILLISECONDS=5000
API_LOCK_WAIT_MILLISECONDS=2000
API_LOCK_POLL_MILLISECONDS=50
API_STUDIO_SETTINGS_PREWARM_ENABLED=false
API_TASK_REFERENCE_PREWARM_ENABLED=false
API_PREWARM_QUEUE_CAPACITY=256
API_PREWARM_STARTUP_DELAY_MILLISECONDS=5000
# Empty by default. Add further entries with the matching indexed .NET setting if required.
API_PREWARM_STARTUP_STUDIO_ID_0=

# --- RabbitMQ (message broker) ---------------------------------------------
# Native Linux: amqp://kuvox:kuvox@localhost:5672/.
# Native macOS: amqp://kuvox:kuvox@localhost:5672/.
# Native Windows: amqp://kuvox:kuvox@localhost:5672/.
# Docker Compose AI container: amqp://kuvox:kuvox@rabbitmq:5672/.
KUVOX_RABBITMQ_URL=amqp://kuvox:kuvox@localhost:5672/
KUVOX_RABBITMQ_EXCHANGE=kuvox.events
KUVOX_RABBITMQ_RETRY_DELAYS_SECONDS=30,120,600
KUVOX_RABBITMQ_RETRY_ATTEMPTS=3
# Queue names consumed by background workers.
KUVOX_QUEUE_RENDERING=kuvox.rendering
KUVOX_QUEUE_SANDBOX=kuvox.sandbox
KUVOX_MEDIA_OPTIMIZATION_REQUESTED_QUEUE=media.optimization.requested
KUVOX_MEDIA_OPTIMIZATION_REQUESTED_ROUTING_KEY=media.optimization.requested
KUVOX_MEDIA_OPTIMIZATION_COMPLETED_ROUTING_KEY=media.optimization.completed
KUVOX_MEDIA_OPTIMIZATION_FAILED_ROUTING_KEY=media.optimization.failed
KUVOX_MEDIA_OPTIMIZATION_CONCURRENCY=1
KUVOX_INGESTION_REQUESTED_QUEUE=ingestion.requested
KUVOX_INGESTION_REQUESTED_ROUTING_KEY=ingestion.requested
KUVOX_INGESTION_COMPLETED_ROUTING_KEY=ingestion.completed
KUVOX_INGESTION_FAILED_ROUTING_KEY=ingestion.failed
KUVOX_INGESTION_CONCURRENCY=1

# --- Object storage (S3-compatible; SeaweedFS for local dev) -------------------
# Native Linux: http://localhost:8333.
# Native macOS: http://localhost:8333.
# Native Windows: http://localhost:8333.
# Docker Compose AI container: http://seaweedfs-s3:8333.
KUVOX_S3_ENDPOINT_URL=http://localhost:8333
KUVOX_S3_REGION=us-east-1
KUVOX_S3_ACCESS_KEY=kuvox-ai-dev
KUVOX_S3_SECRET_KEY=replace-with-local-ai-secret
KUVOX_S3_BUCKET=kuvox-media
KUVOX_S3_RAW_BUCKET=kuvox-raw
KUVOX_S3_CANONICAL_BUCKET=kuvox-canonical
KUVOX_S3_PROXY_BUCKET=kuvox-proxy
KUVOX_S3_THUMBNAIL_BUCKET=kuvox-thumbnails
KUVOX_S3_TEMP_BUCKET=kuvox-temp
# Buckets are created by local bootstrap/dev setup or ops provisioning.
KUVOX_S3_CREATE_BUCKET=false

# --- Media optimization ----------------------------------------------------
# Native Linux: /tmp/kuvox-media is fine.
# Native macOS: /tmp/kuvox-media is fine.
# Native Windows: use a writable Windows path, for example
# KUVOX_MEDIA_WORK_DIR=D:/Kuvox/.codex-tmp/kuvox-media.
# Docker: /tmp/kuvox-media is fine inside the container.
KUVOX_MEDIA_WORK_DIR=/tmp/kuvox-media
KUVOX_RENDERING_WORK_DIR=/tmp/kuvox-rendering
KUVOX_MEDIA_DELETE_RAW_AFTER_OPTIMIZATION=false
KUVOX_VIDEO_CANONICAL_CRF=28
KUVOX_VIDEO_PROXY_CRF=30
KUVOX_VIDEO_PROXY_MAX_WIDTH=1280
KUVOX_IMAGE_MAX_WIDTH=1920
KUVOX_THUMBNAIL_WIDTH=320

# --- Ingestion ------------------------------------------------------------
# Native Linux: /tmp/kuvox-ingestion is fine.
# Native macOS: /tmp/kuvox-ingestion is fine.
# Native Windows: use a writable Windows path, for example
# KUVOX_INGESTION_WORK_DIR=D:/Kuvox/.codex-tmp/kuvox-ingestion.
# Docker: /tmp/kuvox-ingestion is fine inside the container.
KUVOX_INGESTION_WORK_DIR=/tmp/kuvox-ingestion
KUVOX_VISUAL_COLLECTION_NAME=shots_visual
KUVOX_VISUAL_EMBEDDING_DIM=512
KUVOX_TRANSCRIPT_COLLECTION_NAME=shots_transcript
KUVOX_AUDIO_COLLECTION_NAME=shots_audio
KUVOX_OCR_COLLECTION_NAME=shots_ocr
KUVOX_MEDIA_VISUAL_COLLECTION_NAME=media_visual
KUVOX_MEDIA_AUDIO_COLLECTION_NAME=media_audio
KUVOX_MEDIA_TRANSCRIPT_COLLECTION_NAME=media_transcript
KUVOX_MEDIA_OCR_COLLECTION_NAME=media_ocr
KUVOX_TEXT_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
KUVOX_TEXT_EMBEDDING_DIM=384
KUVOX_TEXT_EMBEDDING_DEVICE=auto
KUVOX_TEXT_EMBEDDING_BATCH_SIZE=32
KUVOX_WHISPER_MODEL_NAME=small
KUVOX_WHISPER_DEVICE=auto
KUVOX_WHISPER_COMPUTE_TYPE=auto
KUVOX_AUDIO_EMBEDDING_DIM=1024
KUVOX_AUDIO_EMBEDDING_DEVICE=auto
KUVOX_AUDIO_EMBEDDING_BATCH_SIZE=16
KUVOX_OCR_LANGUAGES=en
KUVOX_OCR_GPU=auto
KUVOX_OCR_MIN_CONFIDENCE=0.3
KUVOX_CLIP_MODEL_NAME=ViT-B-32
KUVOX_CLIP_PRETRAINED=laion2b_s34b_b79k
KUVOX_CLIP_DEVICE=auto
KUVOX_CLIP_BATCH_SIZE=16
KUVOX_VISUAL_INDEX_TIMEOUT_SECONDS=60
KUVOX_OPTIONAL_INDEX_TIMEOUT_SECONDS=60

# --- LLM provider ----------------------------------------------------------
# One of: stub, <future-provider-name>. Only "stub" is implemented today.
KUVOX_LLM_TIER_1_PROVIDER=groq # Main planner
KUVOX_LLM_TIER_2_PROVIDER=groq # Everything else
KUVOX_LLM_TIER_3_PROVIDER=gpt  # Escape hatch

# Groq model
GROQ_LLM_API_KEY=
GROQ_LLM_TIER_1_MODEL=
GROQ_LLM_TIER_2_MODEL=
GROQ_LLM_TIER_3_MODEL=
# OpenAI model
OPENAI_LLM_API_KEY=
OPENAI_LLM_TIER_1_MODEL=
OPENAI_LLM_TIER_2_MODEL=
OPENAI_LLM_TIER_3_MODEL=
# Claude
CLAUDE_LLM_API_KEY=
CLAUDE_LLM_TIER_1_MODEL=
CLAUDE_LLM_TIER_2_MODEL=
CLAUDE_LLM_TIER_3_MODEL=

# --- Model paths (for future ML loading) -----------------------------------
# Reserved for ingestion-tier model artifacts. Not loaded by the scaffold.
KUVOX_MODEL_DIR=./data/models
